# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Application Environment (development | production)
ENVIRONMENT=development
DEBUG=True

# Django Security Key (generate a strong random secret for production)
SECRET_KEY=dev-insecure-secret-key-replace-with-64-char-random-string

# Allowed Hostnames (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# CORS Allowed Origins (comma-separated frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost

# PostgreSQL Database Configuration
DB_NAME=presentation_db
DB_USER=presentation_user
DB_PASSWORD=presentation_secure_password
DB_HOST=db
DB_PORT=5432

# Set to True for local development without a running PostgreSQL instance
USE_SQLITE_FALLBACK=True

# Frontend Environment Variables
VITE_API_URL=http://localhost:8000
VITE_ENABLE_THEATRE_STUDIO=true
